# Server-only LogRocket credentials for the future /api/telemetry proxy.
# NEVER prefix these with VITE_ — they must not ship to the browser.
# Set the same names on your host (Vercel / Netlify / Cloudflare) when Phase 2 is live.

LOGROCKET_API_KEY=
LOGROCKET_ORG_ID=hsztbz
LOGROCKET_APP_ID=portfolio-site-traffic

# Client feature flag (safe to expose): when "true", the HUD fetches /api/telemetry
# instead of mock data. Failed fetch ⇒ chassis will not open.
# VITE_TELEMETRY_REMOTE=false
